{
  "listen": ":7863",
  "account_keys": {
    "qoder_1": {
      "<uid>": "<qoder-secret>"
    },
    "codebuddy_1": {
      "<uid>": "<codebuddy-secret>"
    }
  },
  "auth_file": "./auths/auth.json",
  "state_file": "./data/state.json",
  "server": {
    "max_body_mb": 8
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h",
    "disabled": true
  },
  "models": {
    "codebuddy": [],
    "intl": [],
    "trae": [],
    "qoder": [],
    "doubao": [],
    "deepseek": []
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "travel_hours": [9, 21],
    "activity_hours": [10],
    "keepalive_hours": [22],
    "checkin_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "token_watch_enabled": true,
    "token_watch_interval": "10m",
    "refresh_window": "30m",
    "refresh_window_by_provider": {
      "trae": "2h"
    }
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": ""
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "prompt": {
    "mode": "custom",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "breaker_threshold": 0,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0
  },
  "deepseek": {
    "session_ttl": "24h",
    "session_file": "./data/deepseek_sessions.json"
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  }
}
